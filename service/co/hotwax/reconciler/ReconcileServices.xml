<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="reconcile" noun="ReleaseMetadata" authenticate="true" transaction="ignore" semaphore="fail"
             type="script" location="component://data-reconciler/script/co/hotwax/reconciler/ReconcileReleaseMetadata.groovy">
        <description>Audits release metadata between a reference and target instance. External input failures stop the audit. Repairs are create-only and require DATA_RECONCILE_ADMIN plus the data.reconciler.autoApplyEnabled JVM flag.</description>
        <in-parameters>
            <parameter name="fromTag" required="true"><text-length min="1" max="120"/></parameter>
            <parameter name="toTag" required="true"><text-length min="1" max="120"/></parameter>
            <parameter name="referenceUrl" required="true" allow-html="none"><text-url/></parameter>
            <parameter name="referenceApiKey" allow-html="none"/>
            <parameter name="targetUrl" allow-html="none"/>
            <parameter name="targetApiKey" allow-html="none"/>
            <parameter name="dockerConfigRepo" default-value="hotwax/hotwax-maarg-docker-config" allow-html="none">
                <matches regexp="^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                         message="Docker configuration repository must use owner/repository syntax"/>
            </parameter>
            <parameter name="githubToken" allow-html="none"/>
            <parameter name="entityList" default-value="moqui.basic.EnumerationType,moqui.basic.Enumeration,moqui.basic.StatusType,moqui.basic.StatusItem,moqui.service.message.SystemMessageType" allow-html="none"/>
            <parameter name="autoApply" type="Boolean" default="false"/>
            <parameter name="githubRepo" allow-html="none"/>
            <parameter name="repoPath" allow-html="none"/>
        </in-parameters>
        <out-parameters>
            <parameter name="overallStatus"/>
            <parameter name="auditComplete" type="Boolean"/>
            <parameter name="errors" type="List"/>
            <parameter name="warnings" type="List"/>
            <parameter name="totalCriticalMissing" type="Integer"/>
            <parameter name="totalEnvironmentMissing" type="Integer"/>
            <parameter name="totalConflicts" type="Integer"/>
            <parameter name="totalAutoApplied" type="Integer"/>
            <parameter name="shiftedComponentsCount" type="Integer"/>
            <parameter name="totalOmissionAlerts" type="Integer"/>
            <parameter name="omissionAlerts" type="List"/>
            <parameter name="totalServiceBreakingChanges" type="Integer"/>
            <parameter name="serviceBreakingChanges" type="List"/>
            <parameter name="newServicesIntroduced" type="List"/>
            <parameter name="totalAtRiskScheduledJobs" type="Integer"/>
            <parameter name="atRiskScheduledJobs" type="List"/>
            <parameter name="scriptLocationAlerts" type="List"/>
            <parameter name="resultsByEntity" type="Map"/>
            <parameter name="combinedSyncXml"/>
            <parameter name="summaryReport"/>
        </out-parameters>
    </service>
</services>
